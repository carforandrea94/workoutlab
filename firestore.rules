rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // C'e' un solo tipo di account, e ognuno vede e scrive solo il proprio:
    // niente ruoli, niente dati condivisi fra utenti. Tutto quello che non e'
    // elencato qui sotto resta vietato.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // I campi che il profilo puo' avere. Chi crea un documento non ne porta
    // altri: il profilo e' scritto dal dispositivo, non dall'app, e un campo
    // inventato non deve poter entrare.
    function profileKeys() {
      return ['uid', 'email', 'displayName', 'firstName', 'lastName', 'createdAt',
              'privacyAcceptedAt', 'privacyVersion', 'heightCm', 'sex', 'birthDate'];
    }

    // I soli campi del profilo che l'utente cambia da solo: nome, cognome,
    // data di nascita, sesso e altezza. Tutto il resto - uid, email,
    // accettazione dell'informativa - lo decide l'iscrizione e da qui non si
    // tocca.
    // Le forbici sono ripetute qui e non solo nel client perche' la validazione
    // dell'app e' un suggerimento: a scrivere sul documento e' il dispositivo,
    // non l'app.
    function selfEditableFields() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['heightCm', 'sex', 'birthDate', 'displayName', 'firstName', 'lastName']) &&
        // displayName e' quello che l'app mostra ovunque: vuoto lascerebbe
        // schermate senza nome e un avatar senza iniziale.
        (!keys.hasAny(['displayName']) || (
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() >= 1 &&
          request.resource.data.displayName.size() <= 80
        )) &&
        // Il cognome puo' essere vuoto - c'e' chi non lo mette - ma non altro
        // che una stringa, e non un romanzo.
        (!keys.hasAny(['firstName']) || (
          request.resource.data.firstName is string &&
          request.resource.data.firstName.size() <= 80
        )) &&
        (!keys.hasAny(['lastName']) || (
          request.resource.data.lastName is string &&
          request.resource.data.lastName.size() <= 80
        )) &&
        (!keys.hasAny(['heightCm']) || request.resource.data.heightCm == null || (
          request.resource.data.heightCm is number &&
          request.resource.data.heightCm >= 100 &&
          request.resource.data.heightCm <= 250
        )) &&
        (!keys.hasAny(['sex']) || request.resource.data.sex == null ||
          request.resource.data.sex in ['m', 'f']) &&
        // Solo la forma, non la plausibilita': il giorno esatto non e' affare
        // delle regole, ma una stringa di dieci caratteri in quel formato si'.
        (!keys.hasAny(['birthDate']) || request.resource.data.birthDate == null || (
          request.resource.data.birthDate is string &&
          request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        ));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // Creazione: solo il proprio documento, in fase di iscrizione.
      // L'accettazione dell'informativa e' parte del profilo, non un di piu':
      // senza non c'e' base per trattare peso, pliche, eta' e sesso. Pretenderla
      // qui e non solo nel modulo e' il motivo per cui la regola esiste - a
      // scrivere sul documento e' il dispositivo, non l'app. La versione serve
      // quanto la data: senza, non si saprebbe COSA e' stato accettato.
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(profileKeys()) &&
        request.resource.data.uid == uid &&
        request.resource.data.privacyAcceptedAt is string &&
        request.resource.data.privacyVersion is string;

      allow update: if isOwner(uid) && selfEditableFields();

      // Chiudere il proprio account. Le sottoraccolte non se ne vanno da sole -
      // Firestore non cancella a cascata - quindi l'app le svuota PRIMA del
      // documento.
      allow delete: if isOwner(uid);

      // Dati personali: allenamenti salvati, uscite di corsa, misurazioni,
      // bozze e stato dell'app, protocolli (scheda + dieta + obiettivo di
      // corsa), promemoria. Li legge e li scrive solo il proprietario.
      // La funzione che manda i promemoria (functions/) li legge col proprio
      // accesso di server, che le regole non riguardano.
      match /sessions/{id} {
        allow read, write: if isOwner(uid);
      }
      match /runs/{id} {
        allow read, write: if isOwner(uid);
      }
      match /measurements/{id} {
        allow read, write: if isOwner(uid);
      }
      match /state/{id} {
        allow read, write: if isOwner(uid);
      }
      match /protocols/{id} {
        allow read, write: if isOwner(uid);
      }
      match /promemoria/{id} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
