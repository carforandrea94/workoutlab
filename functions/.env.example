# Copia questo file in functions/.env e metti la chiave pubblica VAPID: la
# stessa di vapidPublicKey in src/environments/environment.ts. Non e' un
# segreto. La privata NON va qui: e' il segreto VAPID_PRIVATE_KEY di Firebase
# (vedi docs/promemoria.md).
VAPID_PUBLIC_KEY=

# Facoltativo: un recapito per i servizi di push (un indirizzo https:// o mailto:).
# VAPID_SUBJECT=https://workout-lab-8c567.web.app
